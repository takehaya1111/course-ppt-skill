{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "独立上下文返回的原始逐页审阅报告",
  "description": "course-raw-review.v1 由实际审阅者写出，保存观察和判断，允许如实记录失败、未达到及否定结论。本模式不给任何结论设置默认值；符合结构不代表设计通过。",
  "$comment": "运行时校验reviewPolicy、冻结原版规则/计划上下文、reviewPackHash、实际上下文、目标原文及全部slide/state的唯一覆盖。末态须有完整原版规则覆盖与条件判断；其他状态可在实际看图后说明如何继承末态。原版零Hard、最多一处剩余Soft不改写，剩余问题须有留存理由；任何needs_decision、明确STYLE未达或未解决事项阻断，跨页重复条件一次整套决定。程序还核文件、渲染与宿主证据、carrierCheck、真实参照及风格观察。记录完整不等于自动判断语义、美感、真实观看、反伪造或用户认可。",
  "type": "object",
  "required": ["schema", "reviewPolicy", "reviewPackHash", "reviewer", "reviewedAt", "status", "unresolvedIssues", "limitations", "deckReview", "designTarget", "pages"],
  "not": {"anyOf": [{"required": ["userAccepted"]}, {"required": ["userApproved"]}]},
  "properties": {
    "schema": {"const": "course-raw-review.v1"},
    "reviewPolicy": {"const": "ppt-master-rubric-coverage.v1", "description": "须由本次独立实际审阅产生；旧报告不能添加字段后自动升级。"},
    "reviewPackHash": {"$ref": "#/$defs/hash"},
    "reviewer": {
      "type": "object",
      "required": ["kind", "name", "contextId"],
      "properties": {
        "kind": {"enum": ["agent", "human"]},
        "name": {"$ref": "#/$defs/text"},
        "contextId": {"$ref": "#/$defs/text", "description": "必须与冻结包及宿主原始指派/返回证据中的审阅上下文一致，并与作者上下文不同；独立性不靠姓名或布尔声明。"}
      }
    },
    "reviewedAt": {"type": "string", "format": "date-time"},
    "status": {"enum": ["pass", "fail"], "description": "审阅者按实际观察填写的整体结论。"},
    "unresolvedIssues": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}, "description": "如实说明静态检查、实际播放、教师认可等证据边界。"},
    "deckReview": {
      "type": "object",
      "required": ["continuity", "hierarchy", "compositionByJob", "referenceComparison"],
      "properties": {
        "continuity": {"$ref": "#/$defs/text"},
        "hierarchy": {"$ref": "#/$defs/text"},
        "compositionByJob": {"$ref": "#/$defs/text"},
        "referenceComparison": {"$ref": "#/$defs/text"},
        "softDecisions": {
          "type": "array",
          "description": "原版deck_wide事项统一决定；相同问题不能逐页分散放行。",
          "items": {"type": "object", "required": ["id", "rule", "decision", "rationale", "slides"], "properties": {"id": {"$ref": "#/$defs/text"}, "rule": {"$ref": "#/$defs/text"}, "decision": {"enum": ["retain", "needs_decision"]}, "rationale": {"$ref": "#/$defs/text"}, "slides": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}}}
        }
      }
    },
    "designTarget": {
      "type": "object",
      "required": ["status", "specQuote", "criteria", "comparison", "remainingGaps"],
      "properties": {
        "status": {"enum": ["met", "not_met"]},
        "specQuote": {"$ref": "#/$defs/text", "description": "逐字保留冻结包中的设计目标。"},
        "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}, "description": "逐字并按原顺序保留冻结包中的准则。"},
        "comparison": {"$ref": "#/$defs/text"},
        "remainingGaps": {"type": "array", "items": {"type": "string"}}
      }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slide", "state", "status", "findings", "untouched_concerns", "needs_human_items", "design_intent_check", "pageJob", "relationships", "realization", "observations"],
        "properties": {
          "slide": {"type": "integer", "minimum": 1},
          "state": {"type": "integer", "minimum": 0},
          "status": {"enum": ["ok", "needs_human", "render_failed", "prereq_failed"], "description": "只读审阅沿用原版逐页状态；本适配不接受 fixed 绕过重新制作、渲染和派发。"},
          "findings": {"type": "array", "items": {"type": "object", "required": ["rule", "severity", "evidence"], "properties": {"rule": {"$ref": "#/$defs/text"}, "severity": {"enum": ["hard", "soft"]}, "evidence": {"$ref": "#/$defs/text"}}}, "description": "保留实际发现；原版H规则不得改标soft，S规则保持soft。只读审阅不声明原地修复。"},
          "untouched_concerns": {
            "type": "array",
            "description": "沿用原版未处置事项，零硬问题且最多一处剩余软问题；非零须说明留存不损害目标的理由。跨页重复项绑定整套决定。与findings同事项用相同rule/evidence及可选element/selector配对；数组内部重复或矛盾不静默合并。",
            "items": {"type": "object", "required": ["rule", "evidence", "reason", "decision", "rationale"], "properties": {"rule": {"$ref": "#/$defs/text"}, "evidence": {"$ref": "#/$defs/text"}, "reason": {"enum": ["soft-cap reached", "ambiguous_design_intent", "deck_wide"]}, "decision": {"enum": ["retain", "needs_decision"]}, "rationale": {"$ref": "#/$defs/text"}, "deckDecisionId": {"$ref": "#/$defs/text"}}}
          },
          "planChecks": {
            "type": "object",
            "required": ["readingMode", "spacing", "pageRole"],
            "properties": {"readingMode": {"$ref": "#/$defs/text"}, "spacing": {"$ref": "#/$defs/text"}, "pageRole": {"$ref": "#/$defs/text"}},
            "description": "每页末态核原版阅读模式、§V间距与§IX角色，写实际观察；角色未声明须如实指出，不能猜作content。"
          },
          "ruleChecks": {
            "type": "array", "minItems": 1,
            "items": {"type": "object", "required": ["rules", "result", "observation"], "properties": {"rules": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[HS][0-9]+$"}}, "result": {"enum": ["clear", "not_applicable", "issue"]}, "observation": {"$ref": "#/$defs/text"}}},
            "description": "每页末态唯一覆盖包中从原版提取的硬/软规则，允许分组，但必须有实际观察/不适用理由。条件豁免沿用原文，不预填通过。"
          },
          "stateReview": {
            "type": "object", "required": ["baselineState", "observation"],
            "properties": {"baselineState": {"type": "integer", "minimum": 0}, "observation": {"$ref": "#/$defs/text"}},
            "description": "非末态可在实际看图后继承本页末态规则覆盖，须说明当前显隐变化及适用性；新问题仍列发现，不能以终态冒充初态。"
          },
          "needs_human_items": {"type": "array", "items": {"type": "object", "properties": {"rule": {"type": "string"}, "suggested_fix_summary": {"type": "string"}}}, "description": "记录需人工处理事项及建议；非空时不能通过交付检查。"},
          "design_intent_check": {
            "type": "object",
            "required": ["spec_says", "render_delivers", "note"],
            "properties": {
              "spec_says": {"$ref": "#/$defs/text", "description": "逐字引用包内本页 §IX 任务；运行时检查它属于本页冻结原文。"},
              "render_delivers": {"type": "boolean", "description": "实际观察后填写是否兑现设计意图。"},
              "note": {"$ref": "#/$defs/text"}
            }
          },
          "pageJob": {"$ref": "#/$defs/text"},
          "relationships": {"$ref": "#/$defs/text"},
          "realization": {"$ref": "#/$defs/text"},
          "observations": {"$ref": "#/$defs/text"},
          "carrierCheck": {"$ref": "#/$defs/text", "description": "本页末态必填：结合原稿和任务判断材料的视觉机会与实际承载，不以图片数量代替判断。"},
          "referenceComparisons": {
            "type": "array",
            "items": {"type": "object", "required": ["referenceId", "observation"], "properties": {"referenceId": {"$ref": "#/$defs/text"}, "observation": {"$ref": "#/$defs/text"}}},
            "description": "本页末态至少一项；referenceId 必须指向冻结包中的真实参照图。"
          },
          "styleChecks": {
            "type": "array",
            "items": {"type": "object", "required": ["path", "observation", "met"], "properties": {"path": {"$ref": "#/$defs/text"}, "observation": {"$ref": "#/$defs/text"}, "met": {"type": "boolean"}}},
            "description": "本页末态逐项回应包内实际存在的风格审阅重点；path 保留冻结包中的路径，met 按实际观察填写。"
          }
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
